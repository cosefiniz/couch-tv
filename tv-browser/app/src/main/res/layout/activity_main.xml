<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1A2029"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton android:id="@+id/btnBack" style="@style/ToolButton" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
            <ImageButton android:id="@+id/btnForward" style="@style/ToolButton" android:src="@drawable/ic_forward" android:contentDescription="@string/forward" />
            <ImageButton android:id="@+id/btnReload" style="@style/ToolButton" android:src="@drawable/ic_reload" android:contentDescription="@string/reload" />
            <ImageButton android:id="@+id/btnHome" style="@style/ToolButton" android:src="@drawable/ic_home" android:contentDescription="@string/home" />

            <TextView
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/address_bg"
                android:clickable="true"
                android:ellipsize="middle"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="@string/address_hint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#E6EDF5"
                android:textColorHint="#8A96A6"
                android:textSize="17sp" />

            <ImageButton android:id="@+id/btnStar" style="@style/ToolButton" android:src="@drawable/ic_star_border" android:contentDescription="@string/star" />
            <ImageButton android:id="@+id/btnMode" style="@style/ToolButton" android:src="@drawable/ic_desktop" android:contentDescription="@string/mode" />
            <ImageButton android:id="@+id/btnZoomOut" style="@style/ToolButton" android:src="@drawable/ic_zoom_out" android:contentDescription="@string/zoom_out" />
            <ImageButton android:id="@+id/btnZoomIn" style="@style/ToolButton" android:src="@drawable/ic_zoom_in" android:contentDescription="@string/zoom_in" />
            <ImageButton android:id="@+id/btnCursor" style="@style/ToolButton" android:src="@drawable/ic_pointer" android:contentDescription="@string/cursor" />
            <ImageButton android:id="@+id/btnMenu" style="@style/ToolButton" android:src="@drawable/ic_menu" android:contentDescription="@string/menu" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progressBackgroundTint="#1A2029"
            android:progressTint="#3D8BFD"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <ScrollView
                android:id="@+id/startPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/startContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="48dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="32dp" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <app.couchtv.browser.CursorView
        android:id="@+id/cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/hint_bg"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
